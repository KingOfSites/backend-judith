# --- App ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_URL=http://localhost:3000

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxx
JUDITH_MODEL_HAIKU=claude-haiku-4-5-20251001
JUDITH_MODEL_SONNET=claude-sonnet-4-6

# --- MySQL/MariaDB (banco `judith`) ---
DATABASE_URL="mysql://usuario:senha@host:3306/judith"

# --- Evolution API ---
# URL do servidor Evolution (local via docker-compose ou Railway)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-esta-chave-em-producao
# Nome da instância criada no Evolution (uma por número de WhatsApp)
EVOLUTION_INSTANCE=judith

# --- OpenAI (Whisper para transcrição de áudio) ---
OPENAI_API_KEY=sk-xxx
LOCAL_EMBEDDINGS_URL=http://embeddings:8080

# Ativar somente depois da migração revisada e configuração da chave OpenAI.
KNOWLEDGE_WORKER_ENABLED=false
# Mesmo segredo servidor-servidor já usado pelo Web Judith; nunca enviar ao navegador.
INTERNAL_API_KEY=configure-o-segredo-compartilhado

# --- Domínio do produto (rodapé do PDF) ---
JUDITH_DOMAIN=judith.com.br
# Sobrescreve URL dos Termos/Privacidade. Em dev: aponta pra URL pública do backend (ex: ngrok).
URL_TERMOS=
