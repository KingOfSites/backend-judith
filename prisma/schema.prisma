generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Tipos de empresa do onboarding (Seção 6 do JUDITH-onboarding-v1)
enum TipoEmpresa {
  MEI
  ME
  EPP
  AUTONOMO
}

enum Plano {
  TRIAL
  ESSENCIAL
  INTERMEDIARIO
  PROFISSIONAL
  COMPLETO
  EMPRESARIAL
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// Roteamento de modelos (Seção 4.1 do briefing v6)
enum ModelTier {
  HAIKU
  SONNET
}

// Estágio do onboarding (Seção 8 do JUDITH-onboarding-v1).
// AGUARDANDO_TERMOS → AGUARDANDO_PERFIL → CONCLUIDO.
enum OnboardingEstado {
  AGUARDANDO_TERMOS
  AGUARDANDO_PERFIL
  CONCLUIDO
  RECUSADO
}

// Perfil enxuto do usuário (~280-300 tokens injetados por sessão).
// Justificativa: ver Seção 4.4 do briefing v6 (memória persistente = perfil enxuto).
model User {
  id              String           @id @default(cuid())
  // Número internacional sem +, formato Evolution (ex: 5511999999999)
  whatsappNumber  String           @unique
  nome            String?
  tipoEmpresa     TipoEmpresa?
  ramo            String?
  cidade          String?
  plano           Plano            @default(TRIAL)
  aceitouTermos   Boolean          @default(false)
  aceitouTermosAt DateTime?
  trialFimEm      DateTime?
  onboarding      OnboardingEstado @default(AGUARDANDO_TERMOS)
  // Mensagem original do Cenário B (usuário já mandou dúvida no primeiro contato).
  // Guardada até o perfil ser coletado, daí respondemos a dúvida original.
  duvidaPendente  String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sessions       Session[]
  reminders      Reminder[]
  usage          UsageEvent[]
  subscriptions  Subscription[]
  avulsoCompras  AvulsoCompra[]
  creditosCortesia CreditoCortesia[]

  @@index([whatsappNumber])
}

// Sessão = janela de conversa ativa. Histórico cheio até 8 turnos,
// resumido a partir do 9º (Seção 4.5 do briefing v6).
model Session {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  summary     String?
  closed      Boolean   @default(false)
  messages    Message[]

  @@index([userId, lastSeenAt])
}

model Message {
  id         String      @id @default(cuid())
  sessionId  String
  session    Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       MessageRole
  content    String      @db.Text
  model      ModelTier?
  // Tokens para auditoria de custo (Seção 8.2 do briefing v6)
  inputTokens     Int?
  outputTokens    Int?
  cacheReadTokens Int?
  cacheWriteTokens Int?
  createdAt  DateTime    @default(now())

  @@index([sessionId, createdAt])
}

// Cache semântico (Seção 4.3 do briefing v6): TTL 24h, hash da pergunta.
model SemanticCache {
  id         String   @id @default(cuid())
  hash       String   @unique
  question   String   @db.Text
  answer     String   @db.Text
  hits       Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([hash])
  @@index([expiresAt])
}

// 3 fluxos de lembrete (Seção 3.4 do briefing v6).
model Reminder {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo      String
  descricao   String?  @db.Text
  dataAlvo    DateTime
  // D-3, D-1, dia: marca cada disparo realizado
  enviadoD3   Boolean  @default(false)
  enviadoD1   Boolean  @default(false)
  enviadoDia  Boolean  @default(false)
  cancelado   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, dataAlvo])
  @@index([dataAlvo, cancelado])
}

// Status da assinatura (fluxo-assinatura-whatsapp-v1).
enum SubscriptionStatus {
  TRIALING       // trial ativo, sem pagamento
  PENDING        // aguardando primeiro pagamento
  ACTIVE         // pago e em dia
  PAST_DUE       // falha de cobrança em curso (dunning D+1 a D+3)
  CANCELED       // cancelada — acesso ativo até subscription.currentPeriodEnd
  SUSPENDED      // dunning estourou ou trial expirou sem upgrade
}

// Método de pagamento escolhido pelo usuário no fluxo de assinatura.
enum PaymentMethod {
  PIX
  CARD
}

// Status do pagamento individual (Mercado Pago: pending, approved, rejected, refunded, in_process).
enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELED
  IN_PROCESS
}

// Catálogo dos planos (v6 §7.2). Permite mudar preço/limite sem alterar enum.
model PlanCatalog {
  id              String   @id @default(cuid())
  codigo          Plano    @unique
  nome            String
  precoCentavos   Int
  duvidasMes      Int?     // null = ilimitado
  analisesMes     Int?
  redacoesMes     Int?
  lembretesMes    Int?
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Assinatura efetiva do usuário. Um usuário tem sempre 1 ativa.
model Subscription {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plano             Plano
  status            SubscriptionStatus @default(TRIALING)
  paymentMethod     PaymentMethod?

  trialEndsAt       DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt        DateTime?
  suspendedAt       DateTime?

  // Referência externa Mercado Pago (subscription/preapproval/customer)
  mpCustomerId      String?
  mpSubscriptionId  String?
  mpCardToken       String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  payments          Payment[]

  @@index([userId, status])
  @@index([currentPeriodEnd])
  @@index([trialEndsAt])
}

model Payment {
  id              String        @id @default(cuid())
  subscriptionId  String
  subscription    Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  metodo          PaymentMethod
  valorCentavos   Int
  status          PaymentStatus @default(PENDING)
  // Referência externa Mercado Pago (payment.id ou preference.id)
  mpPaymentId     String?       @unique
  mpPreferenceId  String?
  pixQrCode       String?       @db.Text
  pixQrCodeImage  String?       @db.Text
  pixCopyPaste    String?       @db.Text
  cardCheckoutUrl String?       @db.Text
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([subscriptionId, createdAt])
  @@index([status, createdAt])
}

// Compra avulsa (v6 §7.2): porta de entrada pra quem não assina, e reforço
// pós-cota pra quem estourou o limite do plano no mês. 1 compra = 1 uso de 1 serviço.
model AvulsoCompra {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  servico         UsageKind
  precoCentavos   Int
  metodo          PaymentMethod
  status          PaymentStatus @default(PENDING)

  // Referência externa Mercado Pago (payment.id ou preference.id)
  mpPaymentId     String?       @unique
  mpPreferenceId  String?
  pixQrCode       String?       @db.Text
  pixQrCodeImage  String?       @db.Text
  pixCopyPaste    String?       @db.Text
  cardCheckoutUrl String?       @db.Text

  paidAt          DateTime?
  // Marcado pelo serviço que atende o WhatsApp quando o crédito é gasto.
  consumidoEm     DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, servico, status])
  @@index([status, createdAt])
}

// Alerta interno pro founder — reconciliação webhook, dunning, etc.
enum AdminAlertKind {
  RECONCILIATION   // pago no gateway mas sem ativação
  PAYMENT_FAILURE  // dunning em curso
  TRIAL_EXPIRING   // trial acaba em 24h
  WEBHOOK_FAILURE  // webhook caiu
}

enum AdminAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model AdminAlert {
  id          String            @id @default(cuid())
  kind        AdminAlertKind
  status      AdminAlertStatus  @default(OPEN)
  titulo      String
  detalhe     String?           @db.Text
  userId      String?
  paymentId   String?
  createdAt   DateTime          @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

// ============================================================
// MULTI-TENANT — Plataforma SaaS de bots WhatsApp
// Cada Cliente paga pra ter 1+ Bots conectados a instâncias Evolution.
// ============================================================

model Cliente {
  id              String         @id @default(cuid())
  email           String         @unique
  senhaHash       String
  nomeNegocio     String
  nomeContato     String?
  whatsappContato String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  bots            Bot[]
  assinatura      AssinaturaCliente?

  @@index([email])
}

enum BotStatus {
  CRIADO        // criado mas nunca pareou WhatsApp
  PAREANDO      // QR gerado, aguardando scan
  ATIVO         // pareado e operando
  DESCONECTADO  // perdeu conexão WhatsApp
  PAUSADO       // cliente desativou
}

model Bot {
  id            String     @id @default(cuid())
  clienteId     String
  cliente       Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome          String
  // Nome único da instância no Evolution (ex: "bot-cuid123")
  instanceName  String     @unique
  status        BotStatus  @default(CRIADO)
  whatsappNumero String?   // preenchido após pareamento
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  config        BotConfig?
  leads         Lead[]
  conversas     Conversa[]

  @@index([clienteId])
  @@index([instanceName])
}

// Persona, tom, instruções e FAQ do bot — configurado pelo cliente.
model BotConfig {
  id           String   @id @default(cuid())
  botId        String   @unique
  bot          Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  persona      String   @db.Text  // "Sou o bot da Loja X, vendo bolos..."
  tom          String   @default("amigável e direto")
  instrucoes   String?  @db.Text  // regras extra do cliente
  faqJson      String?  @db.Text  // FAQ em JSON
  modelo       ModelTier @default(HAIKU)
  updatedAt    DateTime @updatedAt
}

// Quem manda mensagem pro bot (cliente do cliente — número WhatsApp).
model Lead {
  id            String    @id @default(cuid())
  botId         String
  bot           Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  whatsappNumero String
  pushName      String?
  createdAt     DateTime  @default(now())

  conversas     Conversa[]

  @@unique([botId, whatsappNumero])
  @@index([botId])
}

model Conversa {
  id          String    @id @default(cuid())
  botId       String
  bot         Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  fechada     Boolean   @default(false)

  mensagens   MensagemBot[]

  @@index([botId, lastSeenAt])
  @@index([leadId])
}

enum MensagemDirecao {
  IN   // lead → bot
  OUT  // bot → lead
}

model MensagemBot {
  id           String          @id @default(cuid())
  conversaId   String
  conversa     Conversa        @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  direcao      MensagemDirecao
  conteudo     String          @db.Text
  modelo       ModelTier?
  inputTokens  Int?
  outputTokens Int?
  cacheReadTokens Int?
  createdAt    DateTime        @default(now())

  @@index([conversaId, createdAt])
}

enum AssinaturaPlano {
  TRIAL
  STARTER     // R$ 49,90 — 1 bot, até 500 msg/mês
  PRO         // R$ 99,90 — 3 bots, até 2.000 msg/mês
  BUSINESS    // R$ 199,90 — 10 bots, até 10.000 msg/mês
}

enum AssinaturaStatus {
  TRIAL_ATIVO
  ATIVA
  EM_ATRASO
  CANCELADA
}

model AssinaturaCliente {
  id           String           @id @default(cuid())
  clienteId    String           @unique
  cliente      Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  plano        AssinaturaPlano  @default(TRIAL)
  status       AssinaturaStatus @default(TRIAL_ATIVO)
  trialAcabaEm DateTime?
  ativaAte     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// ============================================================
// Banco de dicas proativas do onboarding (Seção 8 do JUDITH-onboarding-v1).
// "usadoPor" registra quem já viu, para não repetir no mesmo usuário.
model TipDicaOnboarding {
  id        String      @id @default(cuid())
  perfil    TipoEmpresa
  texto     String      @db.Text
  ativo     Boolean     @default(true)
  usadoPor  Json        @default("[]")   // lista de userIds (MySQL nao suporta String[])
  createdAt DateTime    @default(now())

  @@index([perfil, ativo])
}

// ============================================================
// PAINEL DE CONTEÚDO — prompt e base de conhecimento editáveis pelo fundador.
// ============================================================

// Prompt único da JUDITH (Seções A/B/C), antes vivia só como .md na VPS.
// Singleton identificado por "chave" — hoje só existe a linha "PRINCIPAL".
model PromptConfig {
  id            String   @id @default(cuid())
  chave         String   @unique @default("PRINCIPAL")
  versao        String
  secaoA        String   @db.Text
  secaoB        String   @db.Text
  secaoC        String   @db.Text
  atualizadoPor String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum FichaStatus {
  RASCUNHO
  EM_REVISAO
  PUBLICADA
}

// Fichas temáticas da base de conhecimento jurídico (antes eram .md soltos
// em knowledge/). Fonte compartilhada do índice consumido na função duvida.
model FichaConhecimento {
  id        String      @id @default(cuid())
  slug      String      @unique
  titulo    String
  area      String
  status    FichaStatus @default(RASCUNHO)
  fontes    Json        @default("[]")
  conteudo  String      @db.LongText
  ordem     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([area])
}

// Índice derivado: sem FK para a fonte compartilhada, não altera seus escritores.
model KnowledgeDocument {
  sourceId    String @id
  fingerprint String @db.Char(64)
  model       String @db.VarChar(191)
  published   Boolean
  chunks      KnowledgeChunk[]
}

model KnowledgeChunk {
  id          String @id @default(cuid())
  sourceId    String
  document    KnowledgeDocument @relation(fields: [sourceId], references: [sourceId], onDelete: Cascade)
  ordinal     Int
  chapter     String @db.LongText
  subchapter  String? @db.LongText
  line        Int
  content     String @db.LongText
  embeddingId String @db.Char(64)
  embedding   KnowledgeEmbedding @relation(fields: [embeddingId], references: [id])
  areas       KnowledgeChunkArea[]
  @@unique([sourceId, ordinal])
}

model KnowledgeChunkArea {
  chunkId String
  area    String @db.VarChar(32)
  chunk   KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  @@id([chunkId, area])
  @@index([area, chunkId])
}

model KnowledgeEmbedding {
  id         String @id @db.Char(64)
  model      String @db.VarChar(191)
  dimensions Int
  vector     Json
  chunks     KnowledgeChunk[]
}

model KnowledgeJob {
  id          String @id @default(cuid())
  requestKey  String @unique @db.VarChar(191)
  activeKey   String? @unique @db.VarChar(32)
  status      String @default("pending") @db.VarChar(16)
  total       Int @default(0)
  processed   Int @default(0)
  result      Json?
  errors      Json?
  leaseUntil  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, createdAt])
}

// Auditoria de uso por plano (limites da Seção 7.2 do briefing v6).
enum UsageKind {
  DUVIDA
  ANALISE
  REDACAO
  LEMBRETE
}

model UsageEvent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      UsageKind
  custoBrl  Float?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
}

// Créditos gratuitos concedidos pelo admin; não são pagamentos nem assinaturas.
model CreditoCortesia {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  servico    UsageKind
  quantidade Int
  saldo      Int
  criadoPor  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, servico, saldo])
}
